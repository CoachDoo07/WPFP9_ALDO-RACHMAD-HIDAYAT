# Server utama  = Server B (UTS): data terenkripsi di DB B, didekripsi lalu dikirim, wajib JWT
VITE_SERVER_UTAMA=http://localhost:4000/api
# Server cadangan = Server A (UTS): data asli dari DB A, tanpa JWT
VITE_SERVER_CADANGAN=http://localhost:3000/api

# Akun login Server B (sama dengan API_USER / API_PASS di server-b/.env)
VITE_API_USER=admin
VITE_API_PASS=admin123

# Batas waktu tunggu (ms). Lewat dari ini dianggap "tidak merespons"
VITE_TIMEOUT_MS=3000
